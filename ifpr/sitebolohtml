<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Agro Sustentável - Agrinho</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        :root{
            --verde:#2e7d32;
            --verde-claro:#81c784;
            --azul:#1976d2;
            --cinza:#f5f7fa;
        }

        body{
            background-color: var(--cinza);
            font-family: 'Segoe UI', sans-serif;
        }

        .navbar{
            background: linear-gradient(90deg,var(--verde),var(--azul));
        }

        .navbar-brand{
            font-weight: bold;
            font-size: 1.4rem;
        }

        .carousel-item img{
            height: 600px;
            object-fit: cover;
            filter: brightness(60%);
        }

        .carousel-caption{
            bottom: 20%;
        }

        .carousel-caption h2{
            font-size: 3rem;
            font-weight: bold;
        }

        .section-title{
            color: var(--verde);
            font-weight: bold;
        }

        .feature-card{
            border: none;
            transition: .3s;
            border-radius: 15px;
        }

        .feature-card:hover{
            transform: translateY(-10px);
            box-shadow: 0 10px 25px rgba(0,0,0,.15);
        }

        .icon-box{
            font-size: 3rem;
            color: var(--verde);
        }

        .about-section{
            background: white;
            border-radius: 20px;
            padding: 50px;
        }

        footer{
            background: #1e293b;
            color: white;
        }

        .btn-custom{
            background-color: var(--verde);
            color: white;
        }

        .btn-custom:hover{
            background-color: #1b5e20;
            color: white;
        }
    </style>
</head>
<body>

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-dark shadow">
    <div class="container">
        <a class="navbar-brand" href="#">
            <i class="bi bi-tree-fill"></i> Agro Sustentável
        </a>

        <button class="navbar-toggler" data-bs-toggle="collapse"
            data-bs-target="#menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menu">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="#">Início</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Projetos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Sustentabilidade</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Contato</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- CARROSSEL -->
<div id="carouselAgrinho" class="carousel slide" data-bs-ride="carousel">

    <div class="carousel-indicators">
        <button type="button" data-bs-target="#carouselAgrinho"
            data-bs-slide-to="0" class="active"></button>

        <button type="button" data-bs-target="#carouselAgrinho"
            data-bs-slide-to="1"></button>

        <button type="button" data-bs-target="#carouselAgrinho"
            data-bs-slide-to="2"></button>
    </div>

    <div class="carousel-inner">

        <div class="carousel-item active">
            <img src="https://images.unsplash.com/photo-1500937386664-56d1dfef3854"
                class="d-block w-100" alt="Agricultura">
            <div class="carousel-caption">
                <h2>Agro Sustentável</h2>
                <p>Tecnologia e preservação caminhando juntas.</p>
            </div>
        </div>

        <div class="carousel-item">
            <img src="https://images.unsplash.com/photo-1464226184884-fa280b87c399"
                class="d-block w-100" alt="Plantação">
            <div class="carousel-caption">
                <h2>Produção Consciente</h2>
                <p>Mais alimentos com menos impacto ambiental.</p>
            </div>
        </div>

        <div class="carousel-item">
            <img src="https://images.unsplash.com/photo-1500382017468-9049fed747ef"
                class="d-block w-100" alt="Tecnologia">
            <div class="carousel-caption">
                <h2>Inovação no Campo</h2>
                <p>Soluções inteligentes para um futuro melhor.</p>
            </div>
        </div>

    </div>

    <button class="carousel-control-prev"
        data-bs-target="#carouselAgrinho"
        data-bs-slide="prev">

        <span class="carousel-control-prev-icon"></span>
    </button>

    <button class="carousel-control-next"
        data-bs-target="#carouselAgrinho"
        data-bs-slide="next">

        <span class="carousel-control-next-icon"></span>
    </button>

</div>

<!-- DESTAQUES -->
<section class="container py-5">
    <h2 class="text-center section-title mb-5">
        Destaques do Projeto
    </h2>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card feature-card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-droplet-half icon-box"></i>
                    <h4 class="mt-3">Economia de Água</h4>
                    <p>
                        Sistemas inteligentes de irrigação que
                        reduzem o desperdício.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card feature-card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-recycle icon-box"></i>
                    <h4 class="mt-3">Reciclagem</h4>
                    <p>
                        Reaproveitamento de materiais e redução
                        dos resíduos agrícolas.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card feature-card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-cpu-fill icon-box"></i>
                    <h4 class="mt-3">Tecnologia</h4>
                    <p>
                        Uso de sensores e monitoramento para
                        aumentar a produtividade.
                    </p>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- SOBRE -->
<section class="container mb-5">
    <div class="about-section shadow">

        <div class="row align-items-center">

            <div class="col-lg-6">
                <img
                    src="https://images.unsplash.com/photo-1501004318641-b39e6451bec6"
                    class="img-fluid rounded-4"
                    alt="Sustentabilidade">
            </div>

            <div class="col-lg-6">
                <h2 class="section-title">
                    Sobre o Projeto
                </h2>

                <p class="lead">
                    O projeto Agro Sustentável busca conscientizar
                    estudantes e produtores sobre práticas
                    agrícolas sustentáveis.
                </p>

                <p>
                    Através da educação, inovação tecnológica
                    e preservação ambiental, é possível garantir
                    produção de alimentos de forma responsável.
                </p>

                <button class="btn btn-custom btn-lg">
                    Saiba Mais
                </button>
            </div>

        </div>

    </div>
</section>

<!-- RODAPÉ -->
<footer class="py-4">
    <div class="container text-center">
        <h5>
            <i class="bi bi-tree-fill"></i>
            Agro Sustentável
        </h5>

        <p>
            Projeto desenvolvido para o Programa Agrinho.
        </p>

        <div class="fs-4">
            <i class="bi bi-instagram me-3"></i>
            <i class="bi bi-facebook me-3"></i>
            <i class="bi bi-youtube"></i>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>